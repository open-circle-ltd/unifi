{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "ruby -e \"s = File.read('lib/unifi/version.rb'); s.sub!(/VERSION = '.*'/, \"VERSION = '${nextRelease.version}'\"); File.write('lib/unifi/version.rb', s)\""
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["lib/unifi/version.rb", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": []
      }
    ]
  ]
}
